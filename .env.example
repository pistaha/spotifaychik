COMPOSE_PROJECT_NAME=music-service
DOCKER_IMAGE_REPOSITORY=your-dockerhub-login/spotifaychik
APP_IMAGE_TAG=latest

API_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_service

ASPNETCORE_ENVIRONMENT=Development
API_MEMORY_LIMIT=256m
API_MEMORY_RESERVATION=192m

JWT_ISSUER=MusicService
JWT_AUDIENCE=MusicServiceClients
JWT_SECRET=music-service-secret-key-32-chars-minimum-20260112
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_AUDIT_CLEANUP_INTERVAL_HOURS=24

FILE_STORAGE_ROOT_PATH=Storage
FILE_STORAGE_MAX_FILE_SIZE_BYTES=5368709120
FILE_STORAGE_MAX_TOTAL_UPLOAD_BYTES=5368709120
FILE_STORAGE_MAX_FILES_PER_UPLOAD=10
FILE_STORAGE_STREAMING_THRESHOLD_BYTES=10485760
FILE_STORAGE_ALLOW_ANY_FILE=true

MEMORY_STRESS_ENABLED=true
MEMORY_STRESS_CHUNK_SIZE_MB=16
MEMORY_STRESS_MAX_CHUNKS=64
